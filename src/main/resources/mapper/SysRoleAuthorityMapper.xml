<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shuaigef.springbootinit.mapper.SysRoleAuthorityMapper">

    <resultMap id="BaseResultMap" type="com.shuaigef.springbootinit.model.entity.SysRoleAuthority">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="authorityId" column="authority_id" jdbcType="BIGINT"/>
            <result property="roleId" column="role_id" jdbcType="BIGINT"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,authority_id,role_id,
        create_time,update_time
    </sql>

    <select id="findAuthorityIdsByRoleId" resultType="java.lang.Long">
        SELECT authority_id
        FROM `sys_role_authority`
        <where>
            role_id = #{roleId}
        </where>
    </select>

    <select id="findAuthorityCodeByRoleId" resultType="java.lang.String">
        SELECT
        a.code
        FROM `sys_role_authority` AS ra
        LEFT JOIN `sys_authority` AS a on a.id = ra.`authority_id`
        <where>
            ra.`role_id` = ${roleId}
        </where>
    </select>
</mapper>
